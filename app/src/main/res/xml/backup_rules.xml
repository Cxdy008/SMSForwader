<?xml version="1.0" encoding="utf-8"?>
<!--
   Regras de backup para API 29–30 (minSdk = 29).
   A app guarda conteúdo de SMS (Room) e o token do bot encriptado com uma chave
   do Android Keystore, que não é restaurada. Nada deve sair do dispositivo via backup.
   allowBackup="false" no manifest já desliga o backup; estas exclusões são uma salvaguarda.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
