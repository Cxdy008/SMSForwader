<?xml version="1.0" encoding="utf-8"?>
<!--
   Regras para API 31+. No Android 12+, allowBackup="false" desliga o backup na nuvem,
   mas NÃO a transferência dispositivo-a-dispositivo; por isso tudo é excluído aqui
   explicitamente, em ambos os casos. Ver backup_rules.xml para a justificação.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
